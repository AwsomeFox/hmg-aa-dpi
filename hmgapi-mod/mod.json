{
  "id": "aa-dpi",
  "name": "Android Auto DPI",
  "version": "0.2.1",
  "hmgapi": ">=1.0.0",
  "authors": [
    "eliotwass",
    "AwsomeFox"
  ],
  "license": "GPL-3.0",
  "description": "For wireless Android Auto, also needs HMG-API's Wireless CarPlay + Android Auto mod. Sets Android Auto's DPI (smaller text, more map) and its tap/scroll limit while driving, from the AA DPI app.",
  "live": true,
  "hooks": {
    "jar": "hooks.jar",
    "entry": "dev.aadpi.hook.DpiHooks",
    "points": {
      "gpm.video_sink.nearest": "change",
      "gpm.sensor_source.init": "change"
    }
  },
  "apps": [
    { "apk": "app/AaDpi.apk", "package": "dev.aadpi.settings" }
  ],
  "provides": {
    "launcher": [
      { "id": "settings", "package": "dev.aadpi.settings", "class": ".SettingsActivity", "title": "AA DPI" }
    ]
  },
  "not_while_driving": ["dev.aadpi.settings"],
  "logs": {
    "match": ["[aa-dpi]"]
  }
}
